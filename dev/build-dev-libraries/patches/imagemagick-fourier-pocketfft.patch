 #define carg(z)  (atan2(cimag(z),creal(z)))
-#endif
-#if !defined(MAGICKCORE_HAVE_CIMAG)
 #define cimag(z)  (z[1])
-#endif
-#if !defined(MAGICKCORE_HAVE_CREAL)
 #define creal(z)  (z[0])
-#endif
